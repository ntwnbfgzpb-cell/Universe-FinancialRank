{
  "version": "TW-RANK-SPEC-v1.2",
  "effective_from": "2026-08-24",
  "numeric_type": "Decimal",
  "first_match_wins": true,
  "grade_scores": {"AA": 4, "A": 3, "BB": 2, "B": 1, "C": 0, "N/A": null},
  "models": {
    "TW6F_GENERAL": {"minimum_valid": 4, "metrics": ["REV_GROWTH", "OP_MARGIN_GENERAL", "NET_PROFIT_GROWTH", "EPS_TTM", "INVENTORY_TURNOVER_Q", "FCF_CORE"]},
    "TW4F_FINANCIAL": {"minimum_valid": 4, "metrics": ["REV_GROWTH", "PRETAX_MARGIN_FINANCIAL", "NET_PROFIT_GROWTH", "EPS_TTM"]},
    "TW4F_SECURITIES": {"minimum_valid": 4, "metrics": ["REV_GROWTH", "OP_MARGIN_SECURITIES", "NET_PROFIT_GROWTH", "EPS_TTM"]}
  },
  "rules": [
    {"metric":"REV_GROWTH","priority":1,"rule_id":"C-REV-01","grade":"C","condition":"avg6 < 0 or latest < 0"},
    {"metric":"REV_GROWTH","priority":2,"rule_id":"B-REV-01","grade":"B","condition":"avg6 > 0 and latest3 strictly decreasing"},
    {"metric":"REV_GROWTH","priority":3,"rule_id":"AA-REV-01","grade":"AA","condition":"all6 > 0 and avg6 > 25 and avg_latest3 >= avg_prior3"},
    {"metric":"REV_GROWTH","priority":4,"rule_id":"A-REV-01","grade":"A","condition":"all6 > 0 and 10 <= avg6 <= 25"},
    {"metric":"REV_GROWTH","priority":5,"rule_id":"A-REV-02","grade":"A","condition":"avg6 > 25 and 0 < relative_slowdown <= 0.5"},
    {"metric":"REV_GROWTH","priority":6,"rule_id":"BB-REV-01","grade":"BB","condition":"any month < 0"},
    {"metric":"REV_GROWTH","priority":7,"rule_id":"BB-REV-99","grade":"BB","condition":"fallback"},
    {"metric":"OP_MARGIN_*","priority":1,"rule_id":"C-OPM-01","grade":"C","condition":"avg4 < 0 or latest < 0"},
    {"metric":"OP_MARGIN_*","priority":2,"rule_id":"B-OPM-01","grade":"B","condition":"latest relative decline >= 0.2 or avg4 <= 5"},
    {"metric":"OP_MARGIN_*","priority":3,"rule_id":"AA-OPM-01","grade":"AA","condition":"no large decline and avg4 >= 15"},
    {"metric":"OP_MARGIN_*","priority":4,"rule_id":"AA-OPM-02","grade":"AA","condition":"no large decline and 10 <= avg4 < 15 and latest improves"},
    {"metric":"OP_MARGIN_*","priority":5,"rule_id":"A-OPM-01","grade":"A","condition":"no large decline and 10 <= avg4 < 15"},
    {"metric":"OP_MARGIN_*","priority":6,"rule_id":"A-OPM-02","grade":"A","condition":"no large decline and 5 < avg4 < 10 and latest improves"},
    {"metric":"OP_MARGIN_*","priority":7,"rule_id":"BB-OPM-01","grade":"BB","condition":"historical large decline"},
    {"metric":"OP_MARGIN_*","priority":8,"rule_id":"BB-OPM-99","grade":"BB","condition":"fallback"},
    {"metric":"NET_PROFIT_GROWTH","priority":1,"rule_id":"C-NP-01","grade":"C","condition":"latest2 < 0"},
    {"metric":"NET_PROFIT_GROWTH","priority":2,"rule_id":"B-NP-01","grade":"B","condition":"latest < 0 or negatives4 >= 2 or latest3 decreasing"},
    {"metric":"NET_PROFIT_GROWTH","priority":3,"rule_id":"AA-NP-01","grade":"AA","condition":"latest3 > 0 and latest improves"},
    {"metric":"NET_PROFIT_GROWTH","priority":4,"rule_id":"AA-NP-02","grade":"AA","condition":"latest3 > 0 and latest3 yoy >= 50"},
    {"metric":"NET_PROFIT_GROWTH","priority":5,"rule_id":"A-NP-01","grade":"A","condition":"latest2 > 0 and decline < 0.5"},
    {"metric":"NET_PROFIT_GROWTH","priority":6,"rule_id":"BB-NP-01","grade":"BB","condition":"latest2 > 0 and decline >= 0.5"},
    {"metric":"NET_PROFIT_GROWTH","priority":7,"rule_id":"BB-NP-02","grade":"BB","condition":"turnaround"},
    {"metric":"EPS_TTM","priority":1,"rule_id":"C-EPS-01","grade":"C","condition":"ttm < 0 or latest < 0"},
    {"metric":"EPS_TTM","priority":2,"rule_id":"AA-EPS-01","grade":"AA","condition":"ttm > 5"},
    {"metric":"EPS_TTM","priority":3,"rule_id":"A-EPS-01","grade":"A","condition":"3 <= ttm <= 5"},
    {"metric":"EPS_TTM","priority":4,"rule_id":"BB-EPS-01","grade":"BB","condition":"1 <= ttm < 3"},
    {"metric":"EPS_TTM","priority":5,"rule_id":"B-EPS-01","grade":"B","condition":"0 <= ttm < 1"},
    {"metric":"INVENTORY_TURNOVER_Q","priority":1,"rule_id":"NA-ITR-01","grade":"N/A","condition":"not applicable"},
    {"metric":"INVENTORY_TURNOVER_Q","priority":2,"rule_id":"C-ITR-01","grade":"C","condition":"latest relative decline >= 0.2"},
    {"metric":"INVENTORY_TURNOVER_Q","priority":3,"rule_id":"B-ITR-01","grade":"B","condition":"historical relative decline >= 0.2"},
    {"metric":"INVENTORY_TURNOVER_Q","priority":4,"rule_id":"BB-ITR-01","grade":"BB","condition":"two declines and cumulative decline >= 0.2"},
    {"metric":"INVENTORY_TURNOVER_Q","priority":5,"rule_id":"AA-ITR-01","grade":"AA","condition":"stable and avg4 > 1.5"},
    {"metric":"INVENTORY_TURNOVER_Q","priority":6,"rule_id":"A-ITR-01","grade":"A","condition":"stable and avg4 <= 1.5"},
    {"metric":"FCF_CORE","priority":1,"rule_id":"AA-FCF-01","grade":"AA","condition":"all6 > 0"},
    {"metric":"FCF_CORE","priority":2,"rule_id":"A-FCF-01","grade":"A","condition":"sum6 >= 0 and sum4 >= 0"},
    {"metric":"FCF_CORE","priority":3,"rule_id":"BB-FCF-01","grade":"BB","condition":"sum6 < 0 and sum4 >= 0"},
    {"metric":"FCF_CORE","priority":4,"rule_id":"B-FCF-01","grade":"B","condition":"sum6 >= 0 and sum4 < 0"},
    {"metric":"FCF_CORE","priority":5,"rule_id":"C-FCF-01","grade":"C","condition":"sum6 < 0 and sum4 < 0"}
  ]
}
